rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper validation functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Isolated user-level tenancy
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create, update, delete: if isOwner(userId) && isValidId(userId);

      // Explicit subcollection for journal reflections
      match /entries/{entryId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(entryId);
        allow create, update, delete: if isOwner(userId) && isValidId(entryId);
      }

      // Explicit subcollection for reflection action items
      match /actions/{actionId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(actionId);
        allow create, update, delete: if isOwner(userId) && isValidId(actionId);
      }

      // Explicit subcollection for user preferences
      match /preferences/{prefId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(prefId);
        allow create, update, delete: if isOwner(userId) && isValidId(prefId);
      }

      // Explicit subcollection for synthesized insights
      match /insights/{insightId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(insightId);
        allow create, update, delete: if isOwner(userId) && isValidId(insightId);
      }

      // Explicit subcollection for discovered reflection patterns
      match /patterns/{patternId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(patternId);
        allow create, update, delete: if isOwner(userId) && isValidId(patternId);
      }

      // Explicit subcollection for integrations & webhooks
      match /integrations/{integrationId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(integrationId);
        allow create, update, delete: if isOwner(userId) && isValidId(integrationId);
      }
    }
  }
}
