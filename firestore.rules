rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Isolated user-level storage rule ensuring strict tenant isolation
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidId(userId);

      // Subcollection for journal entries and multi-turn reflections
      match /entries/{entryId} {
        allow read, write: if isOwner(userId) && isValidId(entryId);
      }

      // Any nested subcollections strictly bounded to the owning user
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
